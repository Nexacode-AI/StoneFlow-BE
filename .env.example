# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/stone_db"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ─── WhatsApp provider ────────────────────────────────────────────────────────
# Meta is used automatically when META_ACCESS_TOKEN + META_PHONE_NUMBER_ID are set.
# Otherwise it falls back to Twilio. If neither is set, runs in DEMO mode (no real sends).

# Meta WhatsApp Cloud API (preferred, production)
META_ACCESS_TOKEN=                            # Permanent System User token from Meta
META_PHONE_NUMBER_ID=                         # Phone number ID (WhatsApp > API Setup)
META_APP_SECRET=                              # App Secret (Settings > Basic) — verifies webhook signatures
META_WEBHOOK_VERIFY_TOKEN=stone_verify_2026   # Any random string; enter the SAME value in the Meta webhook config
# META_GRAPH_VERSION=v21.0                     # Optional: override the Graph API version

# Twilio WhatsApp (fallback / local sandbox testing)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Legacy verify token (still accepted as a fallback for the Meta handshake)
WHATSAPP_VERIFY_TOKEN=stone_webhook_secret_2024

# JWT (for future auth)
JWT_SECRET=change_this_to_a_long_random_string
