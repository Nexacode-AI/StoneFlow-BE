# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/stone_db"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Meta WhatsApp Cloud API
META_ACCESS_TOKEN=your_permanent_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_WABA_ID=your_whatsapp_business_account_id_here

# WhatsApp Webhook Verify Token (any random string — must match what you enter in Meta Console)
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# JWT (for future auth)
JWT_SECRET=change_this_to_a_long_random_string
