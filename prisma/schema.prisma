generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  SALESMAN
  SITE_SUPERVISOR
  CUTTER
  POLISHER
  EDGE_FINISHER
  PACKER
  LOADER
  INSTALLER
  QC_INSPECTOR
  DRIVER
  WORKER
}

enum Language {
  ENGLISH
  BANGLA
  MANDARIN
  BAHASA_MALAY
  TAMIL
}

enum JobStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum StepStatus {
  WAITING
  NOTIFIED
  IN_PROGRESS
  ISSUE
  HELP_NEEDED
  COMPLETED
  SKIPPED
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum SubTaskStatus {
  WAITING
  NOTIFIED
  COMPLETED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Project {
  id            String        @id @default(uuid())
  projectNumber String        @unique
  name          String
  clientName    String
  clientPhone   String?
  description   String?
  location      String?
  status        ProjectStatus @default(PLANNING)
  startDate     DateTime?
  deadline      DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  jobs   Job[]
  levels ProjectLevel[]
}

model ProjectLevel {
  id        String   @id @default(uuid())
  projectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs    Job[]
}

model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?  @unique
  role      Role     @default(WORKER)
  language  Language @default(ENGLISH)
  isActive  Boolean  @default(true)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedSteps    WorkflowStep[]
  assignedSubTasks WorkflowSubTask[]
  messages         WhatsAppMessage[]
  photos           JobPhoto[]
  auditLogs        AuditLog[]
}

model Job {
  id           String    @id @default(uuid())
  jobNumber    String    @unique
  title        String
  clientName   String
  clientPhone  String?
  description  String?
  measurements String?
  material     String?
  color        String?
  startDate    DateTime?
  deadline     DateTime
  status       JobStatus @default(PENDING)
  priority     Priority  @default(NORMAL)
  totalSteps   Int       @default(0)
  completedSteps Int     @default(0)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?

  // Project / hierarchy fields
  projectId      String?
  parentJobId    String?
  levelName      String?
  unitNumber     String?
  projectLevelId String?

  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectLevel ProjectLevel? @relation(fields: [projectLevelId], references: [id], onDelete: Cascade)
  parent       Job?          @relation("SubJobs", fields: [parentJobId], references: [id], onDelete: Cascade)
  subJobs      Job[]         @relation("SubJobs")

  workflowSteps WorkflowStep[]
  photos        JobPhoto[]
  messages      WhatsAppMessage[]
  auditLogs     AuditLog[]
  expenses      JobExpense[]
  revenue       JobRevenue?
}

model WorkflowStep {
  id              String     @id @default(uuid())
  jobId           String
  stepNumber      Int
  name            String
  description     String?
  assignedUserId  String?
  status          StepStatus @default(WAITING)
  startedAt       DateTime?
  completedAt     DateTime?
  dueAt           DateTime?
  notes           String?
  issueText       String?
  durationMinutes Int?
  timerStartedAt  DateTime?
  timerAlertSentAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assignedUser User?         @relation(fields: [assignedUserId], references: [id])
  messages     WhatsAppMessage[]
  photos       JobPhoto[]
  auditLogs    AuditLog[]
  subTasks     WorkflowSubTask[]

  @@unique([jobId, stepNumber])
}

model WorkflowSubTask {
  id               String        @id @default(uuid())
  stepId           String
  title            String
  description      String?
  assignedUserId   String?
  dueAt            DateTime?
  isCompleted      Boolean       @default(false)
  status           SubTaskStatus @default(WAITING)
  order            Int           @default(0)
  issueText        String?
  durationMinutes  Int?
  timerStartedAt   DateTime?
  timerAlertSentAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  step         WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation(fields: [assignedUserId], references: [id])
}

model WhatsAppMessage {
  id          String           @id @default(uuid())
  jobId       String?
  stepId      String?
  userId      String?
  direction   MessageDirection
  waMessageId String?          @unique
  content     String
  messageType String           @default("text")
  status      String           @default("sent")
  sentAt      DateTime         @default(now())

  job  Job?          @relation(fields: [jobId], references: [id])
  step WorkflowStep? @relation(fields: [stepId], references: [id])
  user User?         @relation(fields: [userId], references: [id])
}

model JobPhoto {
  id           String   @id @default(uuid())
  jobId        String
  stepId       String?
  uploadedById String?
  url          String
  thumbnailUrl String?
  caption      String?
  photoType    String   @default("progress")
  uploadedAt   DateTime @default(now())

  job        Job           @relation(fields: [jobId], references: [id])
  step       WorkflowStep? @relation(fields: [stepId], references: [id])
  uploadedBy User?         @relation(fields: [uploadedById], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  jobId       String?
  stepId      String?
  userId      String?
  eventType   String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  job  Job?          @relation(fields: [jobId], references: [id])
  step WorkflowStep? @relation(fields: [stepId], references: [id])
  user User?         @relation(fields: [userId], references: [id])
}

model WorkflowTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  steps       Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSettings {
  id               String   @id @default("singleton")
  companyName      String   @default("Stone Co Sdn Bhd")
  timezone         String   @default("Asia/Kuala_Lumpur")
  notifyAdmin      Boolean  @default(true)
  autoStart        Boolean  @default(false)
  autoStartOnDate  Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model JobExpense {
  id        String   @id @default(uuid())
  jobId     String
  partName  String
  partType  String   @default("ORI")
  quantity  Int      @default(1)
  amount    Float?
  pdfStatus String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JobRevenue {
  id        String   @id @default(uuid())
  jobId     String   @unique
  amount    Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model PersonalExpense {
  id          String   @id @default(uuid())
  description String
  amount      Float
  category    String   @default("General")
  date        DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
